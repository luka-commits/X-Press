# Supabase JS Client (für UI-Reads)
# Ersetze mit deinen Supabase Credentials aus dem Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Prisma Connection (für Writes/Import) - Session Mode
# Ersetze mit deiner Supabase Connection String aus Dashboard → Settings → Database
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Direct Connection für Migrations (gleiche Credentials, direkte Verbindung)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Alternativ für lokale Entwicklung:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/xos"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/xos"

# Google Maps API Key (required for map display on /versand page)
# Get from: Google Cloud Console → APIs & Services → Credentials → Create API Key
# Enable: Maps JavaScript API (requires billing, but free tier includes $200/month credit)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Google Routes API Key (Server-side only, for route optimization)
# Get from: Google Cloud Console → APIs & Services → Credentials → Create API Key
# Enable: Routes API
GOOGLE_ROUTES_API_KEY="your-google-routes-api-key"
