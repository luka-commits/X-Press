// XOS Database Schema
// Säule 1: Digitale Fertigungs-Übersicht

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Für Supabase Migrations
}

// IST-Status für mobile Status-Updates vom Shopfloor
enum IstStatus {
  in_produktion // Currently being worked on
  fertig        // Completed
  problem       // Has issues that need attention
}

// Versand-Status für Versand-Team Workflow
enum VersandStatus {
  offen         // Not yet ready for shipping (default)
  versandbereit // Ready to be shipped
  versendet     // Shipped
}

// Aufträge aus Prinance XML
model Auftrag {
  auftragsnummer String   @id
  kundeId        Int?
  kunde          Kunde?   @relation(fields: [kundeId], references: [id])

  produkttyp          String?
  produktbeschreibung String?
  sachbearbeiter      String?
  sachbearbeiterTelefon String?
  sachbearbeiterEmail   String?
  auflage             Int?     // Auflagenhoehe (Stückzahl)

  liefertermin   DateTime?
  drucktermin    DateTime?
  wtvTermin      DateTime?

  prioritaet     Int?
  status         String   @default("aktiv")

  // Mobile Status-Update fields (IST-Zustand vom Shopfloor)
  istStatus        IstStatus? // Actual production state from shopfloor
  statusKommentar  String?    // Optional comment from worker
  statusUpdatedAt  DateTime?  // When status was last changed

  // Versand Status fields (Versand-Team Workflow)
  versandStatus     VersandStatus? // Shipping status for Versand-Team
  versandKommentar  String?        // Optional comment from shipping team
  versandUpdatedAt  DateTime?      // When shipping status was last changed

  // Lieferadresse fields (für PLZ-Sortierung und Kartenansicht)
  lieferStrasse     String?        // Street address for delivery
  lieferPlz         String?        // Postal code for sorting/clustering
  lieferOrt         String?        // City name
  lieferLand        String?        // Country code/name
  lieferLat         Float?         // Latitude for map marker (from PLZ geocoding)
  lieferLng         Float?         // Longitude for map marker (from PLZ geocoding)

  xmlImportDatum DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  arbeitsgaenge  Arbeitsgang[]

  // Performance indexes for common query patterns
  @@index([status])
  @@index([liefertermin])
  @@index([istStatus])
  @@index([versandStatus])
  @@index([status, liefertermin])
}

// Kunden
model Kunde {
  id            Int       @id @default(autoincrement())
  name          String?
  firma         String?
  telefon       String?
  mobil         String?
  email         String?
  adresse       String?
  externeNummer String?

  auftraege     Auftrag[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Arbeitsgänge (Produktionsschritte)
model Arbeitsgang {
  id              Int       @id @default(autoincrement())
  auftragId       String
  auftrag         Auftrag   @relation(fields: [auftragId], references: [auftragsnummer])

  maschineId      Int?
  maschine        Maschine? @relation(fields: [maschineId], references: [id])

  sortOrder       Int?
  zeitMinuten     Float?
  geplantDatum    DateTime?
  beschreibung    String?
  kostenstelle    String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Performance indexes for FK lookups and date queries
  @@index([auftragId])
  @@index([maschineId])
  @@index([geplantDatum])
}

// Maschinen (Leitmaschinen für Kapazitätsplanung)
model Maschine {
  id                      Int           @id @default(autoincrement())
  name                    String
  kurzname                String?
  kostenstelle            String?       @unique
  tageskapazitaetMinuten  Int           @default(480) // 8 Stunden
  istLeitmaschine         Boolean       @default(false) // true = erscheint in Dashboard/Kalender
  aktiv                   Boolean       @default(true)

  arbeitsgaenge           Arbeitsgang[]

  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
}
